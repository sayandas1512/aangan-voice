# Global integration mode: "mock" (default, no keys needed) or "live"
INTEGRATIONS_MODE=mock

# Per-service overrides (optional) — leave unset to inherit INTEGRATIONS_MODE
VAANI_MODE=
GEMINI_MODE=
CALCOM_MODE=
HUBSPOT_MODE=
RESEND_MODE=

DATABASE_URL=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

VAANI_API_KEY=
VAANI_AGENT_ID=
# Shown once when the webhook is registered in Vaani; verifies X-Webhook-Signature.
VAANI_WEBHOOK_SECRET=
# Self-chosen secret sent by Vaani's tools as the x-vaani-shared-secret header.
VAANI_TOOL_SHARED_SECRET=

CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=
# Cal.com needs a deliverable attendee email; used only if the caller gave none.
CALCOM_FALLBACK_EMAIL=

HUBSPOT_ACCESS_TOKEN=
HUBSPOT_PIPELINE_ID=
HUBSPOT_STAGE_BOOKED=
# Deal stages a consultation outcome moves to (defaults suit HubSpot's default pipeline).
HUBSPOT_STAGE_WON=
HUBSPOT_STAGE_LOST=
HUBSPOT_STAGE_HELD=

RESEND_API_KEY=
RESEND_FROM=

DASHBOARD_PASSWORD=changeme
# Off by default so a reviewer can open /dashboard directly with no login —
# the password gate itself is fully built, set to true to require it.
DASHBOARD_REQUIRE_PASSWORD=false

# Signs the Acknowledge/Held/No-show/Not a fit/Won links in the designer email.
# Set a long random value in production.
ACTION_LINK_SECRET=
# Public origin of the deployed app; used to build the links in emails.
APP_BASE_URL=http://localhost:3000

# Vercel sets this automatically for cron-triggered requests when configured
# as a project env var; /api/cron/retry checks it against the Authorization
# header. Leave unset locally — the route allows requests through in mock
# mode so `curl localhost:3000/api/cron/retry` works without it.
CRON_SECRET=

# Monthly volume used to project the running cost on the dashboard.
EXPECTED_ENQUIRIES_PER_MONTH=200

# Cost assumptions for the dashboard cost panel (INR)
# 2.40 = Vaani's documented textvoice/voicebot rate (4 paise/sec, billed in
# ceil'd whole minutes) as of 2026-10-09 — see DECISIONS.md. This does NOT
# include any separate Twilio/telephony per-minute charge if you bring your
# own number; add that on top once confirmed.
VOICE_COST_INR_PER_MIN=2.40
GEMINI_COST_INR_PER_1K_TOKENS=0
OTHER_FIXED_COST_INR_PER_MONTH=0

STUDIO_HOURS_START=10:00
STUDIO_HOURS_END=19:00
FRONT_DESK_RING_SECONDS=15
ESCALATION_MINUTES_NEAR=15
ESCALATION_MINUTES_FAR=60
TIMEZONE=Asia/Kolkata

# Average project value range shown as an ESTIMATE only, never mixed with actuals
PROJECT_AVG_VALUE_INR_LOW=800000
PROJECT_AVG_VALUE_INR_HIGH=1400000

# Dashboard "Open in HubSpot" deep links (portal id is in any HubSpot URL)
HUBSPOT_PORTAL_ID=
HUBSPOT_APP_BASE=https://app.hubspot.com

# Optional: emailed whenever a call is flagged for a human callback (front desk / founder).
FOLLOWUP_ALERT_EMAIL=
